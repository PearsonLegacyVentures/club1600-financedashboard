# Club 1600 Treasury — Cloudflare Pages server-side variables
# Add these in Cloudflare Pages > Settings > Variables and Secrets.
# Do NOT prefix these with VITE_. They are consumed only by the Pages Function.

TREASURY_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
TREASURY_API_TOKEN=replace-with-a-long-random-private-token
