# Cloudflare Pages server-side variables / secrets.
# Add these in Cloudflare Pages > Settings > Variables and Secrets.
# They are consumed by Pages Functions, not by the browser.


TREASURY_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
TREASURY_API_TOKEN=replace-with-the-private-token-configured-in-apps-script
